# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT="3000"

# JWT_SECRET: Secret key for signing authentication tokens
JWT_SECRET="kaamboard_secret_key_india_2026"

# MONGODB_URI: Optional MongoDB connection string for running with external Mongo instance
# If omitted, KaamBoard runs out-of-the-box using the embedded JSON/in-memory engine.
MONGODB_URI="mongodb://127.0.0.1:27017/kaamboard"
